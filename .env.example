POSTGRES_DB=transactions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/transactions
APP_REDIS_URL=redis://redis:6379/0
APP_REDIS_STREAM_NAME=transactions
APP_REDIS_CONSUMER_GROUP=transaction-processors
APP_REDIS_DEAD_LETTER_STREAM=transactions:dead-letter
APP_REDIS_METRICS_KEY=transaction-service:metrics
APP_REDIS_BATCH_SIZE=10
APP_REDIS_BLOCK_MS=5000
APP_WORKER_RETRY_BASE_DELAY_MS=1000
APP_WORKER_RETRY_MAX_DELAY_MS=30000
